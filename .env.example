# Copy to .env and fill in. Every variable here is validated at startup by
# src/core/config/envParser.ts against src/core/schema/parserSchema.ts.

# Prisma / SQLite connection string (dev).
DATABASE_URL="file:./dev.db"

# CoinGecko REST base URL, WITHOUT a trailing slash.
# Server-side only, so it is never exposed to the browser.
COINGECKO_API_URL="https://api.coingecko.com/api/v3"

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# --- Interim: still read by features/crypto/hooks (client-side fetching).
# Phase 3 moves fetching to the server and these two are deleted in favour of
# the server-only COINGECKO_API_URL above.
NEXT_PUBLIC_API_URL="https://api.coingecko.com/api/v3/coins/markets"
NEXT_PUBLIC_API_URL_SECOND="https://api.coingecko.com/api/v3/coins"
