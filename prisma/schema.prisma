// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/core/generated"
}

datasource db {
  provider = "sqlite"
  // Keep this line. Prisma validates the schema BEFORE applying the override
  // in prisma.config.ts, so without it every CLI command fails with
  // P1012 "Argument url is missing in data source block db".
  // `prisma migrate dev` strips it whenever the config also declares a
  // datasource — if a CLI command starts failing that way, put it back.
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Better Auth core models.
//
// Model and field names are fixed by the library (they come from its
// getAuthTables()); the Prisma adapter resolves models as `prisma[modelName]`
// with modelName in lowercase, which is exactly Prisma's client key for a
// PascalCase model. Renaming a field here breaks the adapter silently, so
// only add, never rename.
//
// Credentials live on Account (providerId = "credential", password = hash) —
// User has no password column.
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions  Session[]
  accounts  Account[]
  watchlist Watchlist[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Application models
// ---------------------------------------------------------------------------

model Watchlist {
  id     String @id @default(cuid())
  userId String
  coinId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, coinId])
}
